-- ==========================================
-- 2. เดินทะลุ ( Noclip )
-- ==========================================
MainTab:CreateToggle({
   Name = "เดินทะลุสิ่งกีดขวาง (Noclip)",
   CurrentValue = false,
   Flag = "NoclipToggle",
   Callback = function(Value)
      NoclipEnabled = Value
