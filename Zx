-- ==========================================
-- 3. มองบทบาท ( Role ESP )
-- ==========================================
local function ClearRoleESP()
   for _, conn in pairs(RoleESPConnections) do
      if typeof(conn) == "RBXScriptConnection" then conn:Disconnect() end
   end
   RoleESPConnections = {}
   for _, player in pairs(Players:GetPlayers()) do
      if player.Character and player.Character:FindFirstChild("AkersESP") then
         player.Character.AkersESP:Destroy()
      end
   end
end

local function UpdateRoleESP()
   ClearRoleESP()
   if not RoleESPEnabled then return end

   for _, player in pairs(Players:GetPlayers()) do
      if player ~= LocalPlayer and player.Character then
         local char = player.Character
         local highlight = Instance.new("Highlight")
         highlight.Name = "AkersESP"
         highlight.Parent = char
         highlight.FillTransparency = 0.5
         highlight.OutlineTransparency = 0

         local isMurderer = false
         local isSheriff = false

         local items = {}
         for _, item in pairs(player.Backpack:GetChildren()) do table.insert(items, item.Name:lower()) end
         for _, item in pairs(char:GetChildren()) do if item:IsA("Tool") then table.insert(items, item.Name:lower()) end end

         for _, itemName in pairs(items) do
            if itemName:find("knife") or itemName:find("murder") or itemName:find("blade") or itemName:find("sword") then
               isMurderer = true
            elseif itemName:find("gun") or itemName:find("revolver") or itemName:find("sheriff") then
               isSheriff = true
            end
         end

         if isMurderer then
            highlight.FillColor = Color3.fromRGB(255, 0, 0) -- สีแดง = ฆาตกร
         elseif isSheriff then
            highlight.FillColor = Color3.fromRGB(0, 100, 255) -- สีฟ้า = ตำรวจ/นายอำเภอ
         else
            highlight.FillColor = Color3.fromRGB(0, 255, 100) -- สีเขียว = คนธรรมดา
         end
      end
   end
end

MainTab:CreateToggle({
   Name = "มองบทบาท (Role ESP)",
   CurrentValue = false,
   Flag = "RoleESPToggle",
   Callback = function(Value)
      RoleESPEnabled = Value
      if RoleESPEnabled then
         UpdateRoleESP()
         table.insert(RoleESPConnections, Players.PlayerAdded:Connect(function() task.wait(1) UpdateRoleESP() end))
         table.insert(RoleESPConnections, Players.PlayerRemoving:Connect(UpdateRoleESP))
      else
         ClearRoleESP()
      end
   end,
})

